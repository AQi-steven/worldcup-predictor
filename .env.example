# 复制为 .env（.env 已在 .gitignore 中，不会入库）
# 供所有 Node 脚本通过 process.env 读取。

# 必填：npoint.io 文档 ID
NPOINT_ID=REPLACE_WITH_NPOINT_ID

# 仅 tools/migrate_to_cloudbase.js 需要：腾讯云 CloudBase 凭证
CLOUDBASE_SECRET_ID=REPLACE_WITH_CLOUDBASE_SECRET_ID
CLOUDBASE_SECRET_KEY=REPLACE_WITH_CLOUDBASE_SECRET_KEY

# 仅 tools/fetch_games.js 需要：worldcup26.ir 的 API Token（JWT）
WC26_API_TOKEN=REPLACE_WITH_WC26_API_TOKEN

# 仅 tools/update-scores.js 需要：调用方注册用的机器人密码
WC26_BOT_PASSWORD=REPLACE_WITH_BOT_PASSWORD
